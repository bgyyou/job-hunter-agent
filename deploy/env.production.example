# ==================== JobHunter 生产环境配置模板 ====================
# 用法：cp deploy/env.production.example .env.production，填真实值。
# .env.production 永远不进 git（.gitignore / .dockerignore 已拦）。

# 运行环境：开启生产模式（JSON 结构化日志等）
ENV=production

# 站点地址：传给 Caddy。备案前填 IP 或 localhost（自签证书），备案后填域名
SITE_ADDRESS=localhost

# ==================== 数据库 ====================
# 必填：生产 PG 密码。app 与 postgres 两个容器共用此值。
POSTGRES_PASSWORD=change_me_to_a_strong_random_password

# ==================== LLM（平台统一出 key）====================
# 平台 key 只存在服务器这个文件里，不进镜像、不进仓库
LLM_API_KEY=your_platform_api_key_here
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.0-flash
LLM_USE_ANTHROPIC_FORMAT=false

# ==================== 爬虫（内测期保守策略）====================
CRAWLER_DAILY_LIMIT=50
HEADLESS_BROWSER=true

# ==================== 日志 ====================
LOG_LEVEL=INFO
